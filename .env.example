# ============================================================
# crypto-dash — Environment Variables
# cp .env.example .env  →  fill real values
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=crypto_dash

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- FastAPI / Auth ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- (auto-built by docker-compose, override if needed) ---
# DATABASE_URL=postgresql+asyncpg://crypto_user:supersecret@postgres:5432/crypto_dash
